# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 运行期数据与数据库（保护个人对账记录）
*.db
*.db-wal
*.db-shm
*.log
*.tmp

# 本地个人凭据与价格表（请使用 *.example.json 模板）
sites.json
credentials.json
credential*.json
dsh_auth.json
proxy_calibration.json
cache_prices.json
cost_ledger.json
host_alias.json
.env

# 打包构建产物
build/work/
build/HermesCacheMonitor/
*.spec.bak

# dist 里的 exe 走 GitHub Release 附件，不进仓库；
# 但保留说明文件（要让 git 能走进 dist/，必须先放行目录本身）
dist/*
!dist/README.md

# 编辑器与系统配置
.vscode/
.idea/
Thumbs.db
Desktop.ini
